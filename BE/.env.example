# ─── Application ──────────────────────────────────────────────
APP_ENV=development
APP_PORT=8000

# ─── Database ─────────────────────────────────────────────────
POSTGRES_USER=transport
POSTGRES_PASSWORD=change-me
POSTGRES_DB=transport
DB_PORT=5432
# Used when running the API on the host (not in Docker)
DATABASE_URL=postgresql+asyncpg://transport:change-me@localhost:5432/transport

# ─── Auth ─────────────────────────────────────────────────────
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=365

# ─── First-start admin (used only while the users table is empty) ─
COMPANY_NAME=My Transport
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_NAME=Admin
