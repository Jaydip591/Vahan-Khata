<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown while the app starts (Android 7-11): ink background with the logo, light status bar icons. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/brand_ink</item>
        <item name="android:navigationBarColor">@color/brand_ink</item>
    </style>
    <!-- Behind the Flutter UI once it runs: ink, so there is no white flash. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/brand_ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
</resources>
