<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: ink background with the gold logo (no text: it shows before
         the app knows the chosen language). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/brand_ink</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="android:windowBackground">@color/brand_ink</item>
        <item name="android:statusBarColor">@color/brand_ink</item>
        <item name="android:navigationBarColor">@color/brand_ink</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/brand_ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
</resources>
